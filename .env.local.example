# Tie point review desk (/approvals) — copy to .env.local for local dev and
# add the same three variables to the Vercel project settings for production.
# NEVER put real values in THIS file: it is committed to the public repo.

# Supabase Dashboard → Project Settings → API Keys → "service_role" (legacy)
# or create a Secret key (sb_secret_...). NEVER expose this to the browser
# or commit it.
SUPABASE_SECRET_KEY=

# Browser login prompt for /approvals (pick anything strong).
APPROVALS_USER=
APPROVALS_PASSWORD=
